# Copy to .env for local dev:  cp .env.example .env
# Then run commands with:       uv run --env-file .env python manage.py ...
# Never commit .env.

DEBUG=true
# Generate a real one: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Admin only (the API uses no cookies, so it needs no CSRF).
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgres://hiddendoor:hiddendoor@localhost:5434/hiddendoor

# The secret tap sequence (comma separated). Lives only on the server.
DOOR_SEQUENCE=3,1,4,1
# Shared counselor password, at least 8 characters.
COUNSELOR_PASSWORD=change-me-counselor

FRONTEND_ORIGIN=http://localhost:5173
COUNSELOR_ORIGIN=http://localhost:5174

# Trusted reverse proxies in front of Django (used to find the client IP for
# throttling). 0 for plain localhost, 1 behind Render or a cloudflared tunnel.
# Required when DEBUG is off.
NUM_PROXIES=0

# Urgency triage. Empty = only the built-in danger-word list runs (works
# offline). Set a key to also have Claude classify each of her messages;
# then the text of those messages is sent to the Anthropic API.
ANTHROPIC_API_KEY=

# Whether the AI check runs at all. Partner organizations choose. true = also
# ask Claude about each of her messages (needs the key above). false = only the
# built-in danger-word list in 8 languages runs, and no text leaves the server.
AI_TRIAGE_ENABLED=true

# When counselors usually reply, shown to her when no counselor is online,
# e.g. 09:00-21:00. Leave empty until the partner has real hours.
COUNSELOR_HOURS=
